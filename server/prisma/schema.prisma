// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Issue 3 — Create and seed IT request categories
// Define a Category model with:
//   id        Int      @id @default(autoincrement())
//   name      String   @unique
//   createdAt DateTime @default(now())
// Then run:  npx prisma migrate dev --name init
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model DevelopmentRequester {
  id          Int      @id @default(autoincrement())
  displayName String
  email       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets        Ticket[]     @relation("TicketRequester")
  removedFiles   Attachment[] @relation("AttachmentRemovedBy")
  migratedUser   User?        @relation("DevelopmentRequesterMigration")
}

model User {
  id                       Int                   @id @default(autoincrement())
  name                     String
  email                    String                @unique
  passwordHash             String
  role                     UserRole
  isActive                 Boolean               @default(true)
  mustChangePassword       Boolean               @default(true)
  developmentRequesterId   Int?                  @unique
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  legacyDevelopmentRequester DevelopmentRequester? @relation("DevelopmentRequesterMigration", fields: [developmentRequesterId], references: [id])
  submittedTickets          Ticket[]              @relation("TicketRequesterUser")
  ownedTickets              Ticket[]              @relation("TicketOwner")
  removedFiles              Attachment[]          @relation("AttachmentRemovedByUser")

  @@index([role, isActive])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  requesterId       Int
  requesterUserId   Int?
  ownerUserId       Int?
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        ITPriority        @default(NOT_SET)
  currentStatus     TicketStatus      @default(NEW)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  requester     DevelopmentRequester @relation("TicketRequester", fields: [requesterId], references: [id])
  requesterUser User?                @relation("TicketRequesterUser", fields: [requesterUserId], references: [id])
  owner         User?                @relation("TicketOwner", fields: [ownerUserId], references: [id])
  category      Category              @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem         @relation(fields: [relatedSystemId], references: [id])
  attachments   Attachment[]

  @@index([requesterId, createdAt])
  @@index([requesterUserId, createdAt])
  @@index([ownerUserId, currentStatus])
}

model Attachment {
  id                 Int                   @id @default(autoincrement())
  ticketId           Int
  originalFilename   String
  storageKey         String                @unique
  mimeType           String
  byteSize           Int
  uploadedAt         DateTime              @default(now())
  removedAt          DateTime?
  removalReason      String?
  removedByRequesterId Int?
  removedByUserId      Int?

  ticket             Ticket                @relation(fields: [ticketId], references: [id])
  removedByRequester DevelopmentRequester? @relation("AttachmentRemovedBy", fields: [removedByRequesterId], references: [id])
  removedByUser      User?                 @relation("AttachmentRemovedByUser", fields: [removedByUserId], references: [id])

  @@index([ticketId, removedAt])
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum ITPriority {
  NOT_SET
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}
