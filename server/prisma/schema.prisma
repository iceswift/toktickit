// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Issue 3 — Create and seed IT request categories
// Define a Category model with:
//   id        Int      @id @default(autoincrement())
//   name      String   @unique
//   createdAt DateTime @default(now())
// Then run:  npx prisma migrate dev --name init
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model DevelopmentRequester {
  id          Int      @id @default(autoincrement())
  displayName String
  email       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets        Ticket[]     @relation("TicketRequester")
  removedFiles   Attachment[] @relation("AttachmentRemovedBy")
  migratedUser   User?        @relation("DevelopmentRequesterMigration")
}

model User {
  id                       Int                   @id @default(autoincrement())
  name                     String
  email                    String                @unique
  passwordHash             String
  role                     UserRole
  isActive                 Boolean               @default(true)
  mustChangePassword       Boolean               @default(true)
  developmentRequesterId   Int?                  @unique
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  legacyDevelopmentRequester DevelopmentRequester? @relation("DevelopmentRequesterMigration", fields: [developmentRequesterId], references: [id], onDelete: Restrict)
  submittedTickets          Ticket[]              @relation("TicketRequesterUser")
  ownedTickets              Ticket[]              @relation("TicketOwner")
  removedFiles              Attachment[]          @relation("AttachmentRemovedByUser")
  publicComments            PublicComment[]
  internalNotes             InternalNote[]
  sessions                  AuthSession[]
  performedActions          ActionTaken[] @relation("ActionPerformer")
  assignedActions           ActionTaken[] @relation("ActionAssignee")
  actionEvents              ActionEvent[]
  workflowEvents            TicketWorkflowEvent[]
  idempotencyRecords        IdempotencyRecord[]

  @@index([role, isActive])
}

model AuthSession {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique
  userId      Int
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  requesterId       Int
  requesterUserId   Int?
  ownerUserId       Int?
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        ITPriority        @default(NOT_SET)
  currentStatus     TicketStatus      @default(NEW)
  problemAppearsResolvedAt DateTime?
  version           Int               @default(1)
  lastResolvedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  requester     DevelopmentRequester @relation("TicketRequester", fields: [requesterId], references: [id])
  requesterUser User?                @relation("TicketRequesterUser", fields: [requesterUserId], references: [id], onDelete: Restrict)
  owner         User?                @relation("TicketOwner", fields: [ownerUserId], references: [id])
  category      Category              @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem         @relation(fields: [relatedSystemId], references: [id])
  attachments   Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
  actions        ActionTaken[]
  actionEvents   ActionEvent[]
  workflowEvents TicketWorkflowEvent[]
  idempotencyRecords IdempotencyRecord[]

  @@index([requesterId, createdAt])
  @@index([requesterUserId, createdAt])
  @@index([ownerUserId, currentStatus])
  @@index([requesterUserId, currentStatus, lastResolvedAt])
  @@index([currentStatus, itPriority, updatedAt])
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATED
  UPDATED
  ASSIGNED
  STATUS_CHANGED
}

model ActionTaken {
  id                Int @id @default(autoincrement())
  ticketId          Int
  performedByUserId Int
  assigneeUserId    Int
  actionDateTime    DateTime
  description       String @db.VarChar(2000)
  result            String @default("") @db.VarChar(2000)
  followUpRequired  Boolean @default(false)
  followUpNote      String @default("") @db.VarChar(2000)
  attachmentNotes   String @default("") @db.VarChar(2000)
  status            ActionStatus @default(PLANNED)
  version           Int @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ticket            Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy       User @relation("ActionPerformer", fields: [performedByUserId], references: [id], onDelete: Restrict)
  assignee          User @relation("ActionAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  events            ActionEvent[]
  idempotencyRecords IdempotencyRecord[]

  @@unique([id, ticketId])
  @@index([ticketId, actionDateTime, id])
  @@index([performedByUserId, createdAt])
  @@index([assigneeUserId, status])
}

model ActionEvent {
  id        Int @id @default(autoincrement())
  actionId  Int
  ticketId  Int
  actorId   Int
  type      ActionEventType
  version   Int
  changes   Json
  createdAt DateTime @default(now())
  action    ActionTaken @relation(fields: [actionId, ticketId], references: [id, ticketId], onDelete: Restrict)
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor     User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actionId, version])
  @@index([ticketId, createdAt, id])
}

model TicketWorkflowEvent {
  id         Int @id @default(autoincrement())
  ticketId   Int
  actorId    Int
  fromStatus TicketStatus
  toStatus   TicketStatus
  version    Int
  createdAt  DateTime @default(now())
  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor      User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([ticketId, version])
  @@index([ticketId, createdAt, id])
}

model IdempotencyRecord {
  id          Int @id @default(autoincrement())
  userId      Int
  ticketId    Int
  operation   String @default("CREATE_ACTION") @db.VarChar(32)
  key         String @db.VarChar(128)
  payloadHash String @db.Char(64)
  actionId    Int
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  action      ActionTaken @relation(fields: [actionId, ticketId], references: [id, ticketId], onDelete: Restrict)

  @@unique([userId, ticketId, operation, key])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String    @db.VarChar(2000)
  createdAt DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String    @db.VarChar(2000)
  createdAt DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model Attachment {
  id                 Int                   @id @default(autoincrement())
  ticketId           Int
  originalFilename   String
  storageKey         String                @unique
  mimeType           String
  byteSize           Int
  uploadedAt         DateTime              @default(now())
  removedAt          DateTime?
  removalReason      String?
  removedByRequesterId Int?
  removedByUserId      Int?

  ticket             Ticket                @relation(fields: [ticketId], references: [id])
  removedByRequester DevelopmentRequester? @relation("AttachmentRemovedBy", fields: [removedByRequesterId], references: [id])
  removedByUser      User?                 @relation("AttachmentRemovedByUser", fields: [removedByUserId], references: [id])

  @@index([ticketId, removedAt])
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum ITPriority {
  NOT_SET
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}
